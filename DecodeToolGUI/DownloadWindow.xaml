<Window x:Class="DecodeToolGUI.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Latest Binary" Height="180" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Download latest decode_suite_full from GitHub releases" TextWrapping="Wrap" Margin="2"/>

        <ProgressBar x:Name="DownloadProgressBar" Grid.Row="1" Height="18" Minimum="0" Maximum="100" Margin="0,8,0,0"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="Ready" Margin="2,8,2,0"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="StartButton" Width="110" Margin="0,0,8,0" Click="StartButton_Click">Download</Button>
            <Button x:Name="CancelButton" Width="80" Click="CancelButton_Click" IsEnabled="False">Close</Button>
        </StackPanel>
    </Grid>
</Window>